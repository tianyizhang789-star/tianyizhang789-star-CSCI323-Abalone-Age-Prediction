# X_train_scaled, X_test_scaled, y_train_age, y_test_age

# --- 步骤 1: 训练 LinearRegression ---
lr = LinearRegression()
lr.fit(X_train_scaled, y_train_age)
y_pred_lr = lr.predict(X_test_scaled)

# --- 步骤 2: 提取系数 (lr.coef_) ---
# 看看哪些特征在线性模型眼中最重要
