import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np

# 1. 计算残差
residuals = y_true - y_pred

# 2. 创建画布
plt.figure(figsize=(15, 6))

# --- 图一：拟合回归图 (证明 R²) ---
plt.subplot(1, 2, 1)
# 绘制散点
plt.scatter(y_true, y_pred, alpha=0.5, color='teal', label='Predicted vs Actual')
# 绘制对角线 (理想情况)
line_coords = np.linspace(y_true.min(), y_true.max(), 100)
plt.plot(line_coords, line_coords, color='red', linestyle='--', linewidth=2, label='Perfect Fit (Standard)')
plt.title(f'Model Fit Analysis\n(R² Score: {r2:.4f})', fontsize=14)
plt.xlabel('Actual Rings (Real Data)')
plt.ylabel('Predicted Rings (MLP Output)')
plt.legend()
plt.grid(True, alpha=0.3)

# --- 图二：误差分布图 (证明 MSE 和 MAE) ---
plt.subplot(1, 2, 2)
sns.histplot(residuals, kde=True, color='purple', bins=30)
plt.axvline(0, color='black', linestyle='--', label='Zero Error Line')
plt.title(f'Error Distribution Analysis\n(MSE: {mse:.4f} | MAE: {mae:.4f})', fontsize=14)
plt.xlabel('Prediction Error (Actual - Predicted)')
plt.ylabel('Frequency')
plt.legend()

plt.tight_layout()
plt.show()
