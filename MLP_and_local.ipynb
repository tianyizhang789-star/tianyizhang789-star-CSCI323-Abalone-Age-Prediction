plt.title('Residuals of Linear Regression\n(Notice the U-shape curve = Non-linearity)')
plt.xlabel('Actual Age')
plt.ylabel('Error (Residuals)')

# (必做) True vs Predicted Plot: 观察两头偏离情况
plt.subplot(1, 2, 2)
plt.scatter(y_test_age, y_pred_lr, alpha=0.5, color='blue')
plt.plot([y_test_age.min(), y_test_age.max()], [y_test_age.min(), y_test_age.max()], 'r--', lw=2)
plt.title('True vs Predicted (Linear Regression)')
plt.xlabel('Actual Age')
plt.ylabel('Predicted Age')

plt.tight_layout()
plt.show()

# 输出指标用于报告
mse_lr = mean_squared_error(y_test_age, y_pred_lr)
r2_lr = r2_score(y_test_age, y_pred_lr)
